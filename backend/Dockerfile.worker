FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o video-worker ./cmd/worker

FROM alpine:3.20

# Add a non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Install FFmpeg and other runtime dependencies
RUN apk add --no-cache \
    ffmpeg \
    ca-certificates \
    tzdata

WORKDIR /home/appuser

# Create necessary directories and set ownership
RUN mkdir -p /home/appuser/storage /home/appuser/assets /home/appuser/temp && \
    chown -R appuser:appgroup /home/appuser/storage /home/appuser/assets /home/appuser/temp

# Copy assets and set ownership
COPY --chown=appuser:appgroup assets ./assets

# Copy the binary from builder stage and set ownership
COPY --chown=appuser:appgroup --from=builder /app/video-worker .

# Switch to the non-root user
USER appuser

# Run the binary
CMD ["./video-worker"]